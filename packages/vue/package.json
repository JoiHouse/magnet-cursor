{
  "name": "@joihouse/magnet-cursor-vue",
  "version": "0.0.0",
  "description": "Vue 3 components, composables and the v-magnet directive for the magnet-cursor engine. Nuxt/SSR safe.",
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "cursor",
    "custom-cursor",
    "magnetic",
    "directive"
  ],
  "license": "MIT",
  "author": "joihouse",
  "homepage": "https://github.com/JoiHouse/magnet-cursor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoiHouse/magnet-cursor.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/JoiHouse/magnet-cursor/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cursor": {
      "types": "./dist/cursor.d.ts",
      "import": "./dist/cursor.js"
    },
    "./magnet": {
      "types": "./dist/magnet.d.ts",
      "import": "./dist/magnet.js"
    },
    "./gravitational-liquid": {
      "types": "./dist/gravitational-liquid.d.ts",
      "import": "./dist/gravitational-liquid.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsup && node ../../scripts/copy-style.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:exports": "publint --strict && attw --pack . --profile node16 --ignore-rules cjs-resolves-to-esm --exclude-entrypoints ./style.css && node ../../scripts/require-smoke.mjs"
  },
  "dependencies": {
    "@joihouse/magnet-cursor-core": "workspace:^"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vue": "^3.5.13"
  }
}
