{
  "name": "magnet-cursor-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "dev": "pnpm -r --parallel --filter \"./packages/*\" run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "lint": "eslint . && prettier --check \"**/*.{ts,tsx,vue,js,json,md,css}\"",
    "format": "prettier --write \"**/*.{ts,tsx,vue,js,json,md,css}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm check:exports && changeset publish",
    "lint:fix": "eslint . --fix && prettier --write \"**/*.{ts,tsx,vue,js,json,md,css}\"",
    "check:exports": "pnpm -r --filter \"./packages/*\" run check:exports"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.8"
  }
}
